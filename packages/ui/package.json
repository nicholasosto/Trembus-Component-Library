{
  "name": "@trembus/ui",
  "version": "0.14.0",
  "description": "Trembus React component library — first-principles UX, claude.ai-clean light, Trembus dark, and reliquary themes.",
  "type": "module",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "design-system",
    "ui-components",
    "data-visualization",
    "command-bar",
    "toolbar",
    "decision-map",
    "swimlane",
    "milestone-track",
    "stepper",
    "rubric",
    "scorecard",
    "weighted-criteria",
    "lead-time",
    "value-stream",
    "bottleneck",
    "accessibility",
    "a11y",
    "design-tokens",
    "css-variables",
    "typescript",
    "trembus"
  ],
  "license": "MIT",
  "author": "Nicholas Osto",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholasosto/Trembus-Component-Library.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/nicholasosto/Trembus-Component-Library/tree/main/packages/ui#readme",
  "bugs": "https://github.com/nicholasosto/Trembus-Component-Library/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check:contracts": "tsx ../../scripts/check-contracts.ts ui",
    "verify:exports": "node ../../scripts/verify-exports.mjs --exclude-entrypoints ./styles.css",
    "validate": "pnpm lint && pnpm typecheck && pnpm check:contracts && pnpm test && pnpm build && pnpm verify:exports",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@trembus/icons": "workspace:^",
    "@trembus/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
