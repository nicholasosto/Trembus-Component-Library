{
  "name": "@trembus/game-viz",
  "version": "0.4.1",
  "description": "Trembus expressive game / cinematic UI — HUD frames, character dossiers, episode decks, title plates, and a gothic talent-tree star-chart. Builds on @trembus/ui primitives and the @trembus/viz spine + the 3-jobs contract; theatrical surface, accessible spine.",
  "type": "module",
  "keywords": [
    "react",
    "game-ui",
    "hud",
    "cinematic",
    "talent-tree",
    "skill-tree",
    "component-library",
    "design-system",
    "model-viewer",
    "3d",
    "accessibility",
    "trembus"
  ],
  "license": "MIT",
  "author": "Nicholas Osto",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholasosto/Trembus-Component-Library.git",
    "directory": "packages/game-viz"
  },
  "homepage": "https://github.com/nicholasosto/Trembus-Component-Library/tree/main/packages/game-viz#readme",
  "bugs": "https://github.com/nicholasosto/Trembus-Component-Library/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check:contracts": "tsx ../../scripts/check-contracts.ts game-viz",
    "verify:exports": "node ../../scripts/verify-exports.mjs --exclude-entrypoints ./styles.css",
    "validate": "pnpm lint && pnpm typecheck && pnpm check:contracts && pnpm test && pnpm build && pnpm verify:exports",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@trembus/icons": "workspace:^",
    "@trembus/tokens": "workspace:^",
    "@trembus/ui": "workspace:^",
    "@trembus/viz": "workspace:^"
  }
}
